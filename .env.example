# --- GitHub App ---
# From your GitHub App settings page (Settings → Developer settings → GitHub Apps)
GITHUB_APP_ID=123456
GITHUB_WEBHOOK_SECRET=change-me-to-a-long-random-string
# The App private key (.pem). Paste the full contents, or point to a file path
# via GITHUB_PRIVATE_KEY_PATH instead. Newlines in the value must be real newlines
# or escaped as \n.
GITHUB_PRIVATE_KEY=
GITHUB_PRIVATE_KEY_PATH=

# --- LLM (provider-agnostic via LangChain) ---
# Swap models by changing these two lines — no code change.
#   Free local testing:  groq       / llama-3.3-70b-versatile
#   Production:           anthropic  / claude-sonnet-5
#   Also works:           openai     / gpt-4o   (install the 'openai' extra)
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile

# Only the key for your chosen provider is needed.
# Get a free Groq key at https://console.groq.com/keys
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Infra ---
REDIS_URL=redis://localhost:6379

# --- Billing (optional for the core loop) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Behaviour ---
MAX_FILES=40
MAX_DIFF_BYTES=400000
