# --- GitHub App ---
# From your GitHub App settings page (Settings → Developer settings → GitHub Apps)
GITHUB_APP_ID=123456
GITHUB_WEBHOOK_SECRET=change-me-to-a-long-random-string
# The App private key (.pem). Paste the full contents, or point to a file path
# via GITHUB_PRIVATE_KEY_PATH instead. Newlines in the value must be real newlines
# or escaped as \n.
GITHUB_PRIVATE_KEY=
GITHUB_PRIVATE_KEY_PATH=

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-...
# Model used for the review agent loop. Sonnet 5 is the cost/quality sweet spot.
REVIEW_MODEL=claude-sonnet-5

# --- Infra ---
REDIS_URL=redis://localhost:6379

# --- Billing (optional for the core loop) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Behaviour ---
# Max files to review per PR, max total diff bytes, and the agent-loop cap.
MAX_FILES=40
MAX_DIFF_BYTES=400000
MAX_TOOL_CALLS=3
MAX_AGENT_ITERATIONS=6
